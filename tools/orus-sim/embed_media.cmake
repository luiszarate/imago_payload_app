# Writes OUTPUT, a C++ file holding the bytes of each file in INPUTS as
# imago::sim::kMediaAssets (name, data, size), so the simulator and the tests need no data
# folder at run time.
set(body "// Generated by tools/orus-sim/embed_media.cmake from testdata/media. Do not edit.\n")
string(APPEND body "#include \"media_assets.h\"\n\nnamespace imago::sim {\nnamespace {\n")
set(table "")
set(index 0)
foreach(input IN LISTS INPUTS)
    get_filename_component(name "${input}" NAME)
    file(READ "${input}" hex HEX)
    string(LENGTH "${hex}" length)
    math(EXPR size "${length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
    string(APPEND body "const unsigned char asset${index}[] = {\n${bytes}};\n")
    string(APPEND table "    {\"${name}\", asset${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "} // namespace\n\nconst MediaAsset kMediaAssets[] = {\n${table}};\n")
string(APPEND body "const size_t kMediaAssetCount = sizeof(kMediaAssets) / sizeof(kMediaAssets[0]);\n\n")
string(APPEND body "} // namespace imago::sim\n")
file(WRITE "${OUTPUT}" "${body}")
