# Build output
/build*/
/out/
*.o
*.a
*.so
*.dylib

# Apple
.DS_Store
DerivedData/
xcuserdata/
*.xcuserstate
.swiftpm/
.build/
# Generated by XcodeGen from apple/project.yml
apple/*.xcodeproj/

# Traffic captures may contain customer data: keep them out of git
*.pcap
*.pcapng
/captures/
# Field MAVLink logs (.tlog): positions and telemetry
/logs/
*.tlog

# Editors
.vscode/
.idea/
*.swp
compile_commands.json
.cache/
# Generated by XcodeGen
apple/ImagoPayloadControl/Info.plist

# Desktop app (Qt)
/desktop/build*/
/desktop/vcpkg_installed/
__pycache__/

# Design tool (impeccable) scratch: decision pages, review screenshots
/.impeccable/mocks/
/.impeccable/questions/
/.impeccable/review/

# Signing keys (the Quest APK's fixed key and the Android release key) never go in git
*.jks
*.keystore
keystore.properties
